NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Calendar (optional). Leave empty and the "Connect Google Calendar" button explains it isn't set up.
# Create the OAuth client in Google Cloud (see README or the setup steps), then fill these in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in Google Cloud exactly, e.g.
#   http://localhost:3000/timesheet/google/callback
#   https://vyntics-website.vercel.app/timesheet/google/callback
GOOGLE_REDIRECT_URI=
# 32 random bytes, base64. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts each person's Google refresh token before it is stored. Never commit it, never change it
# (changing it disconnects everyone).
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ---- Access control (see supabase/step24_access.sql and `npm run seed:users`) ----
# Google accounts on these domains can sign in. Comma separated; vyntics.com when left empty.
ALLOWED_DOMAINS=vyntics.com
# This person is made an admin by `npm run seed:users` (only if there is no admin yet, or they aren't on the list).
INITIAL_ADMIN_EMAIL=
# An emergency admin who signs in with email + password. Both must be set. The password must be 10+ characters.
# Keep real values only in .env.local, never in this file.
EMERGENCY_ADMIN_EMAIL=
EMERGENCY_ADMIN_PASSWORD=
# How long a sign-in lasts before the person must sign in again, in hours (1 to 720). 12 when left empty.
SESSION_MAX_HOURS=12
# SECRET. Only used by `npm run seed:users` on your computer. Supabase -> Project Settings -> API -> service_role.
# Never commit it, never expose it in the browser, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
